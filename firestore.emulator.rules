rules_version = '2';
// EMULATOR ONLY. Never deploy this file.
//
// Used by the local robot-user emulator, where a wildcard is harmless because
// nothing real is behind it. The production rules are in firestore.rules, and
// firebase.json points there, not here.
//
// This file used to be called firestore.rules while the real rules lived only
// in the Firebase console. Anyone deploying the repo would have replaced the
// live rules with this wildcard and reopened every collection.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
