rules_version = '2';
// Sandbox rules used ONLY by the local robot-user emulator.
// These are NOT the production rules for jericho-operation.
// They mirror the intended production rule: signed-in (even anonymously) only.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
